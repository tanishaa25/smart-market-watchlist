# --- Firestore (required) ---
# 1. Create a project at https://console.firebase.google.com
# 2. Build > Firestore Database > Create database (any region, test mode is fine for dev).
# 3. Project settings (gear icon) > Service accounts > Generate new private key.
#    This downloads a JSON file — do NOT commit it to version control.
# 4. Point the app at it ONE of these two ways:

# Option A — path to the downloaded JSON file (most common for local dev):
GOOGLE_APPLICATION_CREDENTIALS=

# Option B — paste the JSON contents directly as one line (useful when you
# can't use a file, e.g. some hosting platforms). Only set ONE of these two.
# FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Sessions ---
# Any long random string. If left blank, a random one is generated at
# startup, but that means everyone gets logged out on every server restart.
JWT_SECRET=

# --- Live market data (optional) ---
# Free key: https://finnhub.io/register
# If left blank, the server falls back to a realistic simulated feed.
FINNHUB_API_KEY=

# --- Testing only (optional) ---
# How long (in milliseconds) before "since last checked" resets its
# baseline. Defaults to 30 minutes if unset — that's the real, intended
# behavior. For fast local testing, set this low (e.g. 30000 = 30
# seconds) so you can watch the diff appear without waiting half an hour.
# Remove this line (or leave it unset) before demoing/submitting.
# SESSION_GAP_MS=30000

# Forces every quote to use the simulated feed, skipping Finnhub/NSE/
# Yahoo entirely — useful when the market is closed, you're offline, or
# you just want fast/predictable data for testing without waiting on
# real network calls. Note: real feeds actually still return the last
# traded price even when markets are closed, so this isn't needed just
# because it's after-hours — it's for deliberately testing the
# simulated-data code path itself. Remove before demoing/submitting.
# FORCE_SIMULATED=true

# --- AI change explanations (optional) ---
# Free key: https://aistudio.google.com/apikey
# Generates a one-sentence plain-language explanation of a stock's move —
# but ONLY for `live` (real trade) quotes, never for simulated ones, since
# there's no real cause behind a simulated price to honestly explain.
# If left blank, this feature is simply skipped (no error).
GEMINI_API_KEY=
# Optional override — defaults to "gemini-flash-latest" (an alias Google
# keeps pointed at their current recommended fast model, so this doesn't
# go stale as model versions change).
# GEMINI_MODEL=gemini-flash-latest

PORT=4000
